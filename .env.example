# ==============================================================================
# AI Security Engineer Portfolio Project - Phase 1 Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your '.env' file or share your API keys publicly!

# [Required] Groq Cloud API Key
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# [Optional] Default Groq Model
# Supported options available on your Groq tier include:
# - qwen/qwen3.8-27b (Fast, excellent defensive reasoning & instruction following)
# - openai/gpt-oss-120b (Large open model)
# - openai/gpt-oss-20b (Compact high-speed model)
# - allam-2-7b
GROQ_MODEL=qwen/qwen3.8-27b

# [Optional] Maximum user message length (characters)
MAX_MESSAGE_LENGTH=4000

# [Optional] Default System Prompt for the AI Security Assistant
DEFAULT_SYSTEM_PROMPT="You are Sentinel AI, a specialized AI Security Engineer assistant. Your focus is on defensive cybersecurity, secure software architecture, threat modeling (STRIDE), vulnerability analysis, and secure coding best practices. Provide professional, clear, and actionable security advice. Never generate malicious exploits, bypass defensive security perimeters, or participate in unauthorized actions."
